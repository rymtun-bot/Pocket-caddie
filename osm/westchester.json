198,"lon":-118.4068672},{"lat":33.9561693,"lon":-118.404885}],"tags":{"description":"A very scenic hole with jets landing in background. It\u2019s advisable to position the approach to right of this 515-yard par 5. The hole doglegs slightly left to a large undulating green protected by numerous large greenside bunkers.","golf":"hole","handicap":"14","par":"5","ref":"15"}},{"type":"way","id":791884251,"bounds":{"minlat":33.956354,"minlon":-118.4062663,"maxlat":33.9567722,"maxlon":-118.4047616},"geometry":[{"lat":33.9567722,"lon":-118.4047616},{"lat":33.956354,"lon":-118.4062663}],"tags":{"description":"This 160-yard par 3 is the longest par 3 on the back 9, but consistently plays even longer with afternoon winds, really challenging club selection. Two large bunkers bookend large undulating green.","golf":"hole","handicap":"4","par":"3","ref":"16"}},{"type":"way","id":791884252,"bounds":{"minlat":33.9564063,"minlon":-118.4097726,"maxlat":33.9567931,"maxlon":-118.4064493},"geometry":[{"lat":33.9567931,"lon":-118.4064493},{"lat":33.9564063,"lon":-118.4081818},{"lat":33.9565186,"lon":-118.4097726}],"tags":{"description":"This 160-yard par 3 is the longest par 3 on the back 9, but consistently plays even longer with afternoon winds, really challenging club selection. Two large bunkers bookend large undulating green.","golf":"hole","handicap":"4","par":"4","ref":"17"}},{"type":"way","id":791884253,"bounds":{"minlat":33.9570807,"minlon":-118.4104734,"maxlat":33.9592912,"maxlon":-118.4094576},"geometry":[{"lat":33.9570807,"lon":-118.4094576},{"lat":33.958431,"lon":-118.4098116},{"lat":33.9592912,"lon":-118.4104734}],"tags":{"description":"Approach on the right to avoid a steep leftside bunker of this 300-yard par 4. There\u2019s a bailout area to the right, but an afternoon wind can take the ball even further than planned!","golf":"hole","handicap":"18","par":"4","ref":"18"}},{"type":"way","id":791884254,"bounds":{"minlat":33.9565141,"minlon":-118.4108733,"maxlat":33.9592266,"maxlon":-118.4103424},"geometry":[{"lat":33.9592266,"lon":-118.4108733},{"lat":33.9578381,"lon":-118.4103424},{"lat":33.9565141,"lon":-118.4104628}],"tags":{"description":"A 340-yard par 4. A slight downhill tee shot with uphill approach to a large double-tiered green protected by steep bunker on right.","golf":"hole","handicap":"16","par":"4","ref":"10"}},{"type":"way","id":791884255,"bounds":{"minlat":33.9548956,"minlon":-118.4104042,"maxlat":33.95611,"maxlon":-118.4101964},"geometry":[{"lat":33.95611,"lon":-118.4104042},{"lat":33.9548956,"lon":-118.4101964}],"tags":{"description":"A smaller green protected by a leftside bunker. There are drop-offs on the right and back, so don\u2019t get too aggressive on this 150-yard par 3. ","golf":"hole","handicap":"8","par":"3","ref":"11"}},{"type":"way","id":791884256,"bounds":{"minlat":33.954485,"minlon":-118.4097504,"maxlat":33.9556761,"maxlon":-118.4095333},"geometry":[{"lat":33.954485,"lon":-118.4095333},{"lat":33.9556761,"lon":-118.4097504}],"tags":{"description":"This 150-yard par 3 consistently plays longer than its yardage. The huge pea-shaped bunker on the right gobbles up shots that tend to die to the right.","golf":"hole","handicap":"6","par":"3","ref":"14"}},{"type":"way","id":791884257,"bounds":{"minlat":33.9542332,"minlon":-118.4113779,"maxlat":33.9545237,"maxlon":-118.4099956},"geometry":[{"lat":33.9542332,"lon":-118.4113779},{"lat":33.9545237,"lon":-118.4099956}],"tags":{"description":"A slight downhill and downwind shot tests club selection off this narrow tee box on Hole 13\u2019s 148-yard par 3.","golf":"hole","handicap":"12","par":"3","ref":"13"}},{"type":"way","id":791884258,"bounds":{"minlat":33.9542352,"minlon":-118.411851,"maxlat":33.954676,"maxlon":-118.4104676},"geometry":[{"lat":33.954676,"lon":-118.4104676},{"lat":33.9542941,"lon":-118.4116661},{"lat":33.9542352,"lon":-118.411851}],"tags":{"description":"This 148-yard par 3 is a very tight shot to a narrow green tucked in next to an O.B. boundary fence with the airport just across the road; it\u2019s made even more challenging by afternoon breezes in your face.","golf":"hole","handicap":"10","par":"3","ref":"12"}},{"type":"way","id":791884259,"bounds":{"minlat":33.9548122,"minlon":-118.4107672,"maxlat":33.9559953,"maxlon":-118.4105248},"geometry":[{"lat":33.9548122,"lon":-118.4105248},{"lat":33.9559953,"lon":-118.4107672}],"tags":{"description":"A 141-yard par 3. Don\u2019t pull the ball or you risk the steep drop-off on the left side of green; otherwise, a good size green presents a birdie opportunity.","golf":"hole","handicap":"5","par":"3","ref":"8"}},{"type":"way","id":791884260,"bounds":{"minlat":33.954894,"minlon":-118.4125931,"maxlat":33.9566316,"maxlon":-118.4110723},"geometry":[{"lat":33.9566316,"lon":-118.4125931},{"lat":33.9550965,"lon":-118.4118716},{"lat":33.954894,"lon":-118.4110723}],"tags":{"description":"A dogleg left encourages a slight draw off the tee, but O.B. on left protects the third tee box and penalizes aggressive play. It is best to play out to right with a little draw for the best approach angle, and to stay safe on this 286-yard par 4. ","golf":"hole","handicap":"11","par":"4","ref":"7"}},{"type":"way","id":791884261,"bounds":{"minlat":33.9553679,"minlon":-118.4121344,"maxlat":33.9566182,"maxlon":-118.41148},"geometry":[{"lat":33.9553679,"lon":-118.41148},{"lat":33.9566182,"lon":-118.4121344}],"tags":{"description":"A slightly uphill, challenging 176-yard par 3 hole. It\u2019s the longest par 3 on the course.","golf":"hole","handicap":"1","par":"3","ref":"3"}},{"type":"way","id":791884262,"bounds":{"minlat":33.9542851,"minlon":-118.412947,"maxlat":33.956483,"maxlon":-118.4121983},"geometry":[{"lat":33.9542851,"lon":-118.4121983},{"lat":33.956483,"lon":-118.412947}],"tags":{"description":"Another narrowing fairway encourages imagination on approach shots to the smaller green to maximize birdie opportunities on this 297-yard par 4.","golf":"hole","handicap":"9","par":"4","ref":"6"}},{"type":"way","id":791884263,"bounds":{"minlat":33.9544666,"minlon":-118.4134955,"maxlat":33.956575,"maxlon":-118.4126975},"geometry":[{"lat":33.956575,"lon":-118.4134955},{"lat":33.9544666,"lon":-118.4126975}],"tags":{"description":"A 267-yard, drivable par 4 with a narrowing approach to the green, and a front left greenside bunker challenge for those who try. If the planes in the distance don\u2019t give it away, the radar tower on right gives perspective to proximity to airport.","golf":"hole","handicap":"9","par":"4","ref":"5"}},{"type":"way","id":791884264,"bounds":{"minlat":33.9569271,"minlon":-118.4133168,"maxlat":33.9570384,"maxlon":-118.4119793},"geometry":[{"lat":33.9570384,"lon":-118.4119793},{"lat":33.9569271,"lon":-118.4133168}],"tags":{"description":"A large bunker protects the left side of the green and you can count on southerly afternoon winds to play havoc with drawing or fading tee shots on this 145 yard, par 3 hole.","golf":"hole","handicap":"7","par":"3","ref":"4"}},{"type":"way","id":791884265,"bounds":{"minlat":33.9553658,"minlon":-118.4117476,"maxlat":33.9579218,"maxlon":-118.4111662},"geometry":[{"lat":33.9579218,"lon":-118.4117476},{"lat":33.9553658,"lon":-118.4111662}],"tags":{"description":"This 317-yard par 4 has the only water hazard on the course, 240 yards out, which makes a left lay-up the smart play here. Our several long-time resident domestic geese call the pond their home, along with many traveling Canadian Geese that visit seasonal","golf":"hole","handicap":"3","par":"4","ref":"2"}},{"type":"way","id":791884266,"bounds":{"minlat":33.9563898,"minlon":-118.4112407,"maxlat":33.9590578,"maxlon":-118.4108401},"geometry":[{"lat":33.9563898,"lon":-118.4108401},{"lat":33.9590578,"lon":-118.4112407}],"tags":{"description":"The course\u2019s signature hole features a large eucalyptus in the center of fairway in which a family of hawks has made their home for decades. A drive to the right of the tree is favorable for the best approach